{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../target/release/openjarvis-hook.exe": null,
      "../target/release/openjarvis-hook": "openjarvis-hook"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libgtk-layer-shell0 (>= 0.6)",
          "libasound2"
        ]
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell",
          "alsa-lib"
        ]
      }
    },
    "shortDescription": "Assistente com IA no topo da tela",
    "longDescription": "Jarvis é um assistente pessoal com IA que vive num notch no topo da tela: entende voz e texto, toca música no Spotify, cuida da agenda, lê e-mails quando você pede, acha arquivos e mostra clima e uso do PC."
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "OpenJarvis",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
